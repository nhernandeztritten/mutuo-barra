{
  "name": "mutuo-barra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cuaderno de barra para el coffee cart de Mutuo. PWA offline para iPad.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "contraste": "node scripts/contraste.mjs",
    "verifica:ui": "node scripts/verifica-ui.mjs",
    "verifica:pwa": "node scripts/verifica-pwa.mjs",
    "capturas": "node scripts/capturas.mjs",
    "capturas:ultimos": "node scripts/capturas-fase-6.mjs",
    "capturas:editar": "node scripts/capturas-fase-7.mjs",
    "capturas:movil": "node scripts/capturas-fase-9.mjs",
    "capturas:auditoria": "node scripts/capturas-fase-10.mjs",
    "capturas:peticiones": "node scripts/capturas-fase-11.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@preact/signals": "^1.3.4",
    "dexie": "^4.4.5",
    "lucide-preact": "^0.454.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
